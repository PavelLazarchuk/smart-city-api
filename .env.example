# Runtime
NODE_ENV=development
PORT=8080
API_PREFIX=api/v1
LOG_LEVEL=debug
# Defaults to true, except in production where it must be switched on explicitly
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
UPLOADS_CORS_ORIGINS=
UPLOADS_CACHE_MAX_AGE=1h
BODY_LIMIT=1mb
TRUST_PROXY=false

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_RETRY_WRITES=true
MONGO_WRITE_CONCERN=majority
MONGO_READ_PREFERENCE=primary

# Metrics: /api/v1/metrics in the Prometheus text format.
METRICS_ENABLED=true
METRICS_TOKEN=

# Reported by GET /health/info
BUILD_VERSION=1.0.0
BUILD_SHA=

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=5m
JWT_REFRESH_TTL=7d
# Key ids travel in the token header. To rotate: put the old key in *_PREVIOUS_KEYS as kid:secret
# (comma separated), publish the new secret + kid, and drop the old entry once its tokens expired.
JWT_ACCESS_KID=access-1
JWT_REFRESH_KID=refresh-1
JWT_ACCESS_PREVIOUS_KEYS=
JWT_REFRESH_PREVIOUS_KEYS=
# Claims every token carries and every verification demands: a staging token is refused in production
# even when the two deployments share a secret.
JWT_ISSUER=smart-city-api
JWT_AUDIENCE=smart-city-clients
AUTH_ADMIN_LOGIN_METHOD=password
AUTH_CITIZEN_LOGIN_METHOD=sms
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
AUTH_LOCKOUT_MAX_SECONDS=3600
AUTH_FAILED_ATTEMPT_WINDOW_SECONDS=3600

# One-time codes
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Phone numbers: E.164 with this country calling code (digits only, no plus)
PHONE_COUNTRY_CODE=375

# Rate limiting. THROTTLE_LIMIT applies to /auth/*; the global limit is a multiple of it.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10
THROTTLE_GLOBAL_LIMIT=200
THROTTLE_UPLOAD_LIMIT=20
THROTTLE_STORAGE=mongo

# How long a remembered Idempotency-Key replays the response of the booking it created
IDEMPOTENCY_TTL=24h

PUBLIC_SITE_URL=http://localhost:5173
DEFAULT_CURRENCY=USD

OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=30
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
BOOKING_REMINDER_HOURS=24

# Pagination
PAGINATION_DEFAULT_LIMIT=30
PAGINATION_MAX_LIMIT=100
PAGINATION_MAX_PAGE=1000
INCLUDE_MAX_ITEMS=50

# SMS: console | smpp. "console" is refused when NODE_ENV=production (it logs the code).
SMS_PROVIDER=console
SMPP_URL=smpp://<host>:<port>
SMPP_SYSTEM_ID=<system-id>
SMPP_PASSWORD=<password>
SMPP_SOURCE_ADDR=SmartCity
SMS_HOURLY_LIMIT=200
SMS_DAILY_LIMIT=1000

# Mail: console | smtp. "console" is refused when NODE_ENV=production.
MAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_REJECT_UNAUTHORIZED=true
MAIL_FROM_NAME=Smart City
MAIL_FROM_ADDRESS=noreply@example.com

# Storage: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:8080/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/jpeg,image/png
# Decoded pixels, not bytes: a highly compressed image is small on the wire and huge in memory.
UPLOAD_MAX_PIXELS=40000000
UPLOAD_MAX_DIMENSION=10000

# Retention / horizons
ARCHIVE_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=365
SMS_RETENTION_DAYS=365
BOOKING_HISTORY_RETENTION_DAYS=365
SERVICE_TRASH_RETENTION_DAYS=30
RECURRENT_HORIZON_DAYS=30

# Scheduled jobs (only the process with JOBS_ENABLED=true registers schedulers)
JOBS_ENABLED=false
JOBS_TIMEZONE=Europe/Minsk
JOB_LOCK_TTL_SECONDS=300
JOB_RECURRENT_SLOTS_CRON=0 3 * * *
JOB_NEWS_EXPIRY_CRON=0 */2 * * *
JOB_SLOT_EXPIRY_CRON=30 3 * * *
JOB_STALE_BOOKINGS_CRON=0 4 * * *
JOB_CASCADE_RECONCILE_CRON=30 4 * * *
JOB_CASCADE_RECONCILE_LIMIT=25
JOB_STORAGE_GC_CRON=0 5 * * *
JOB_DEBTOR_REPORT_CRON=0 12 * * *
JOB_UNREFERENCED_IMAGES_CRON=30 12 * * *
JOB_OUTBOX_DISPATCH_CRON=* * * * *
JOB_BOOKING_REMINDERS_CRON=0 * * * *
JOB_TRASH_PURGE_CRON=0 6 * * *
STORAGE_GC_MIN_AGE=24h
REPORT_RECIPIENTS=reports@example.com
