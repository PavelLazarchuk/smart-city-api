NODE_ENV=development
LOG_LEVEL=warn
SWAGGER_ENABLED=false
JOBS_ENABLED=false

MONGO_URI=mongodb://127.0.0.1:27017/smart-city-load?replicaSet=rs0&directConnection=true
MONGO_MAX_POOL_SIZE=20

THROTTLE_LIMIT=1000000
THROTTLE_GLOBAL_LIMIT=1000000
THROTTLE_UPLOAD_LIMIT=1000000
THROTTLE_STORAGE=mongo

AUTH_CLIENT_LOGIN_METHOD=password
AUTH_MAX_FAILED_ATTEMPTS=1000000
JWT_ACCESS_TTL=4h

SMS_PROVIDER=console
MAIL_PROVIDER=console
STORAGE_PROVIDER=local
METRICS_ENABLED=true
