{
    "name": "smart-city-api",
    "version": "1.0.0",
    "description": "Smart City API",
    "private": true,
    "license": "UNLICENSED",
    "author": "Pavel Lazarchuk <pavel.lazarchuk.personal@gmail.com>",
    "packageManager": "npm@11.9.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "nest build",
        "start": "node dist/main",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:unit": "jest --selectProjects unit",
        "test:e2e": "jest --selectProjects e2e",
        "migrate:create": "migrate-mongo create",
        "migrate:up": "migrate-mongo up",
        "migrate:down": "migrate-mongo down",
        "migrate:status": "migrate-mongo status",
        "migrate:verify": "ts-node -P tsconfig.scripts.json scripts/verify-migrations.ts",
        "seed": "ts-node -P tsconfig.scripts.json scripts/seed.ts",
        "audit": "npm audit --audit-level=high",
        "prepare": "husky"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1129.0",
        "@nestjs/common": "11.2.3",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.2.3",
        "@nestjs/jwt": "11.0.2",
        "@nestjs/mongoose": "11.0.4",
        "@nestjs/platform-express": "11.2.3",
        "@nestjs/schedule": "6.1.3",
        "@nestjs/swagger": "11.4.7",
        "@nestjs/terminus": "11.1.1",
        "@nestjs/throttler": "6.5.0",
        "argon2": "0.45.1",
        "compression": "1.8.1",
        "cron": "4.4.0",
        "date-fns": "4.4.0",
        "exceljs": "4.4.0",
        "helmet": "8.3.0",
        "migrate-mongo": "14.0.7",
        "mongoose": "8.24.4",
        "multer": "2.3.0",
        "nestjs-pino": "5.1.0",
        "nestjs-zod": "5.5.0",
        "nodemailer": "10.0.3",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "pino-pretty": "13.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "smpp": "0.6.0-rc.4",
        "source-map-support": "^0.5.21",
        "swagger-ui-express": "^5.0.1",
        "ulid": "3.0.2",
        "zod": "4.6.1"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "11.1.0",
        "@nestjs/testing": "11.2.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/compression": "1.8.1",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/multer": "2.2.0",
        "@types/node": "22.20.2",
        "@types/nodemailer": "8.0.1",
        "@types/supertest": "7.2.1",
        "dotenv": "^17.4.2",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "husky": "9.1.7",
        "jest": "30.5.1",
        "lint-staged": "17.5.0",
        "mongodb-memory-server": "11.2.0",
        "prettier": "3.9.6",
        "supertest": "7.2.2",
        "ts-jest": "29.4.12",
        "ts-node": "10.9.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0"
    },
    "overrides": {
        "uuid": "^11.1.1"
    }
}
